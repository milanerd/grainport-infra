# Shared baseline hardening headers for public web delivery.
(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Content-Security-Policy-Report-Only "default-src 'self' https: data: blob:; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' https: data: blob:; font-src 'self' https: data:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob:; connect-src 'self' https: wss:; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; worker-src 'self' blob:; form-action 'self' https:;"
		-Server
	}
}

# GrainFreak umbrella website
grainfreak.com {
	redir https://www.grainfreak.com{uri} permanent
}

www.grainfreak.com {
	import secure_headers
	root * /srv/grainport/grainfreak-website/current
	file_server
	encode zstd gzip
}

# Optional staging website for GrainFreak marketing QA
test.grainfreak.com {
	import secure_headers
	root * /srv/grainport/grainfreak-website-test/current
	file_server
	encode zstd gzip
}

# GrainPort production app runtime
grainport.app {
	import secure_headers
	root * /srv/grainport/grainport-webapp/current
	encode zstd gzip
	try_files {path} {path}.html {path}/index.html /index.html
	file_server
}

# Redirect www host to the canonical GrainPort app host
www.grainport.app {
	redir https://grainport.app{uri} permanent
}

# GrainPort staging app runtime
test.grainport.app {
	import secure_headers
	root * /srv/grainport/grainport-webapp-test/current
	encode zstd gzip
	try_files {path} {path}.html {path}/index.html /index.html
	file_server
}

# GrainPort APIs
api.grainport.app {
	import secure_headers
	request_body {
		max_size 1mb
	}
	reverse_proxy 127.0.0.1:4000
}

api-staging.grainport.app {
	import secure_headers
	request_body {
		max_size 1mb
	}
	reverse_proxy 127.0.0.1:4001
}
